# Application
APP_NAME=FleaMarket
APP_ENV=local
APP_URL=http://localhost:3000

# API Base URL (バックエンドAPIのURL)
API_BASE_URL=http://localhost:8000/api

# Stripe (決済機能)
# 本番キーは絶対にコミットしないこと！
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxx
# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx

# Mail (Mailhog - ローカル開発用)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@fleamarket.local
MAIL_FROM_NAME="${APP_NAME}"

# Storage / File Upload
# 画像アップロード先の設定
STORAGE_DRIVER=local
# 最大アップロードサイズ (MB)
MAX_FILE_SIZE=10
# 許可する画像形式
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# AWS S3 (本番環境でS3を使う場合)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Database (バックエンドAPI用 - 参考)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleamarket
DB_USERNAME=root
DB_PASSWORD=

# Authentication
# JWT Secret (バックエンドと共有する場合)
JWT_SECRET=your-secret-key-here
# セッションタイムアウト (分)
SESSION_TIMEOUT=60

# External APIs
# 住所検索API (例: 郵便番号検索)
ZIPCODE_API_KEY=

# Debug & Logging
DEBUG=false
LOG_LEVEL=info

# CORS設定 (バックエンド側)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# その他
# ページネーション: 1ページあたりの商品数
ITEMS_PER_PAGE=20
